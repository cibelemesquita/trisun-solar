# ==============================================================================
# .gitignore - TRISUN Inteligência Solar
# ==============================================================================

# Sistema Operacional / Arquivos do Sistema
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs e Editores de Código
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Arquivos de Ambiente e Credenciais / Segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets.json

# Logs e Diagnósticos
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.pid
*.seed
*.pid.lock

# Python Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Gerenciadores de Pacotes / Builds (se aplicável futuramente)
node_modules/
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/

# Arquivos Temporários
tmp/
temp/
*.bak
*.tmp
